{
  "name": "harry-potter-mmo-server",
  "version": "1.0.0",
  "description": "Nakama server modules pour MMO Harry Potter",
  "main": "build/index.js",
  "scripts": {
    "build": "npx esbuild src/main.ts --bundle --outfile=build/index.js --platform=node --target=es2020",
